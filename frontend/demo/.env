# Canonical version-controlled demo UI configuration.
#
# Vite bakes these public values into the static nginx image during build.
# Keep deploy-specific API keys out of commits unless they are disposable
# demo credentials intended to be visible in the browser bundle.

VITE_DEMO_PUBLIC_API_BASE_URL=http://127.0.0.1:8083/v1
VITE_DEMO_PUBLIC_API_KEY=
VITE_DEMO_DEFAULT_AGENT_NAME=support-cases-http-demo
VITE_DEMO_MESSAGE_TRACE_DISPLAY_MODE=debug
